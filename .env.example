# ── Database ─────────────────────────────────────────────────────────────────
# SQLite (local dev — no setup required):
DATABASE_URL=sqlite:///./ocen.db

# PostgreSQL (Docker / production):
# DATABASE_URL=postgresql://ocen:ocen_password@localhost:5432/ocen_db

# ── Google Maps ───────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=

# ── Amadeus Flight Search ─────────────────────────────────────────────────────
AMADEUS_API_KEY=
AMADEUS_API_SECRET=

# ── Redis (only needed for production caching; not required for local dev) ────
# REDIS_URL=redis://redis:6379/0

# ── Security ──────────────────────────────────────────────────────────────────
SECRET_KEY=change_me_in_production
